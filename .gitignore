# Ignore Python bytecode and cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Home Assistant runtime / local config (never commit)
.storage/
**/.storage/
home-assistant.log*
*.log
*.log.*

# Ignore secrets and sensitive files
secrets.yaml
**/secrets.yaml
*.sk
.env
.env.*
*.env
!.env.example

# Ignore history CSV files
custom_components/sifely_cloud/history/*.csv

# Ignore todo file
todo

# Ignore virtual environments (common names)
env/
venv/
.venv/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore backups or temp files
*.bak
*.swp
*.tmp
